# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MSSQL)
# ⚠️ REQUIRED in production - Set these to your actual production database values
# Example for Azure SQL: your-server.database.windows.net
# Example for AWS RDS: your-instance.region.rds.amazonaws.com
# Example for local SQL Server with named instance: localhost\SQLEXPRESS
DB_SERVER=your-production-server.database.windows.net
DB_PORT=1433
DB_NAME=burak_db
DB_USER=your_username
DB_PASSWORD=your_secure_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=10
ALLOWED_FILE_TYPES=application/pdf

# Application Settings
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
