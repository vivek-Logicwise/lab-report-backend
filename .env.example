# Server Configuration
PORT=3000
NODE_ENV=production

# PostgreSQL Configuration (Google Cloud SQL)
# ⚠️ REQUIRED in production - Set these to your actual production database values
DB_HOST=34.55.228.77
DB_PORT=5432
DB_NAME=BurakPrecision
DB_USER=vivek
DB_PASSWORD={-cUD3p_Z7.zPr"&
DB_SSL=false

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# Concurrency Control Settings (Semaphore Limits)
# PDF Processing: Number of PDFs that can be processed simultaneously
PDF_CONCURRENCY_LIMIT=3
# Database Operations: Number of concurrent database operations (queries/transactions)
DB_CONCURRENCY_LIMIT=10
# API Requests: Number of concurrent API request handlers
API_CONCURRENCY_LIMIT=50

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=10
ALLOWED_FILE_TYPES=application/pdf

# Application Settings
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
