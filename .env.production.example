# Production Environment Configuration
# Copy this to your production environment's environment variables
# DO NOT commit this file with actual credentials

# ⚠️ CRITICAL: Set NODE_ENV to production
NODE_ENV=production

# ========================================
# REQUIRED - Application will exit if missing
# ========================================

# PostgreSQL Configuration (Google Cloud SQL)
# Instance: waseem-mvp:us-central1:waseem-mvp-test-db
# Project: Waseem MVP
DB_HOST=34.55.228.77

# Database Port (PostgreSQL default)
DB_PORT=5432

# Database Name
DB_NAME=BurakPrecision

# Database Authentication
DB_USER=vivek
# Note: Password contains special characters - wrap in single quotes if using .env file
# In cloud platforms (Azure/AWS), paste directly without quotes
DB_PASSWORD='{-cUD3p_Z7.zPr"&'

# ========================================
# RECOMMENDED - Security & Performance
# ========================================

# Enable SSL for production (set to true for Cloud SQL with SSL)
DB_SSL=false

# Connection Pool for Production (higher than dev)
DB_POOL_MIN=5
DB_POOL_MAX=50

# Connection Timeouts (milliseconds)
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# ========================================
# OPTIONAL - Application Settings
# ========================================

# Server Port
PORT=3000

# Logging Level (error, warn, info, debug)
LOG_LEVEL=warn

# File Upload Settings
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=10
UPLOAD_TEMP_DIR=/tmp/uploads

# Rate Limiting (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (comma-separated, optional)
# CORS_ORIGINS=https://yourapp.com,https://api.yourapp.com

# ========================================
# Platform-Specific Examples
# ========================================

# Azure App Service
# Set these in: Portal > App Service > Configuration > Application settings

# AWS Elastic Beanstalk
# Set these in: .ebextensions/environment.config or via EB CLI

# Heroku
# Set via: heroku config:set VAR_NAME=value

# Docker Compose
# Set in docker-compose.yml under 'environment' or use .env file

# Kubernetes
# Create a Secret and reference in deployment.yaml

# ========================================
# Security Notes
# ========================================
# 1. Never commit credentials to version control
# 2. Use your platform's secrets management (AWS Secrets Manager, Azure Key Vault, etc.)
# 3. Rotate passwords regularly
# 4. Use strong passwords (16+ characters, mixed case, numbers, symbols)
# 5. Enable firewall rules to restrict database access
# 6. Monitor failed login attempts
# 7. Enable audit logging on your database server
